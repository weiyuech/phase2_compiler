{
  "name": "robot-live-ui",
  "version": "1.1.0-test.7",
  "description": "Robot Live System Control Panel",
  "author": "Robot Live System",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "test:machines": "node scripts/machine-shell-smoke.mjs",
    "test:upgrade-audio": "node scripts/machine-upgrade-smoke.mjs",
    "preview": "electron-vite preview",
    "package": "node scripts/gen-icon.mjs && node scripts/prepare-backend.mjs && electron-vite build && electron-builder"
  },
  "dependencies": {
    "element-plus": "^2.7.0",
    "onnxruntime-web": "^1.18.0",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@vitejs/plugin-vue": "^5.0.4",
    "electron": "^41.10.3",
    "electron-builder": "^26.15.7",
    "electron-vite": "^3.1.0",
    "playwright": "1.62.1",
    "vite": "^6.4.3",
    "vue": "^3.4.21"
  },
  "build": {
    "publish": null,
    "appId": "com.robot.live",
    "productName": "机器人直播控制台",
    "icon": "build/icon.png",
    "directories": {
      "output": "../release"
    },
    "files": [
      "out/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/backend/node_modules",
        "to": "backend/node_modules"
      },
      {
        "from": "../src",
        "to": "backend/src",
        "filter": [
          "**/*.js"
        ]
      },
      {
        "from": "resources/backend-seed/config",
        "to": "backend/config",
        "filter": [
          "banned-words.txt",
          "llm-system-prompt.txt",
          "barrage-prompt-name.txt",
          "barrage-prompt-general.txt"
        ]
      },
      {
        "from": "resources/backend-seed/data",
        "to": "backend/data",
        "filter": [
          "models/PP-OCRv6_medium_det.onnx",
          "models/PP-OCRv6_medium_rec.onnx",
          "models/ppocrv6_dict.txt",
          "tour-list.json",
          "transit-audio.json",
          "audio-output.json",
          "barrage-knowledge/config.json"
        ]
      },
      {
        "from": "../package.json",
        "to": "backend/package.json"
      },
      {
        "from": "resources/backend-seed/.env.example",
        "to": "backend/.env.example"
      },
      {
        "from": "../ffplay.exe",
        "to": "backend/ffplay.exe"
      },
      {
        "from": "build/tray-icon.png",
        "to": "tray-icon.png"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "executableName": "robot-live-ui"
    },
    "nsis": {
      "artifactName": "Setup.${version}.${ext}",
      "oneClick": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "include": "build/installer.nsh"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "需要麦克风权限以检测助播讲解并自动暂停机器人播报"
      }
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png"
    }
  }
}
