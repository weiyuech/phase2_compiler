# Clean first-install settings. Enter credentials in the application settings.
# This file is a reviewed template, never copied from a developer's .env.
KB_PROVIDER=flatfile
KB_FLATFILE_DIR=./data/flatfiles
KB_SQLITE_PATH=./data/knowledge.db
LLM_PROVIDER=doubao
LLM_FALLBACK_PROVIDER=deepseek
DOUBAO_API_KEY=
DOUBAO_MODEL=
DEEPSEEK_API_KEY=
DEEPSEEK_PLATFORM=official
DEEPSEEK_ARK_API_KEY=
DEEPSEEK_ARK_MODEL=
DEEPSEEK_MODEL=deepseek-chat
QWEN_API_KEY=
QWEN_MODEL=qwen3.8-flash
LLM_MAX_TOKENS=4096
BANNED_WORDS_FILE=./config/banned-words.txt
ROBOT_URL=
ROBOT_PORT=8765
NGROK_AUTHTOKEN=
TTS_API_KEY=
TTS_APP_ID=
TTS_ACCESS_TOKEN=
TTS_VOICE_TYPE=
TTS_CLUSTER=
TTS_RESOURCE_ID=
TTS_AUTH_MODE=api-key
TTS_TIMEOUT_MS=30000
DUCK_VOLUME=0.2
DUCK_FADE_MS=500
BARRAGE_DOUBAO_API_KEY=
BARRAGE_DOUBAO_MODEL=
BARRAGE_DEEPSEEK_API_KEY=
BARRAGE_DEEPSEEK_PLATFORM=official
BARRAGE_DEEPSEEK_ARK_API_KEY=
BARRAGE_DEEPSEEK_ARK_MODEL=
BARRAGE_QWEN_API_KEY=
BARRAGE_QWEN_MODEL=qwen3.8-flash
BARRAGE_LLM_PROVIDER=doubao
BARRAGE_LLM_FALLBACK_PROVIDER=deepseek
BARRAGE_TTS_API_KEY=
BARRAGE_TTS_APP_ID=
BARRAGE_TTS_ACCESS_TOKEN=
BARRAGE_TTS_VOICE_TYPE=
BARRAGE_TTS_CLUSTER=
BARRAGE_TTS_RESOURCE_ID=
BARRAGE_TTS_AUTH_MODE=
BARRAGE_TTS_TIMEOUT_MS=30000
BARRAGE_LLM_MAX_TOKENS=500

# Each profile is independent; blanks never inherit another profile.
SPEECH_PROFILES_VERSION=1
# Independent credentials for transition audio and manual speech.
TRANSIT_DOUBAO_API_KEY=
TRANSIT_DOUBAO_MODEL=
TRANSIT_DEEPSEEK_API_KEY=
TRANSIT_DEEPSEEK_PLATFORM=official
TRANSIT_DEEPSEEK_ARK_API_KEY=
TRANSIT_DEEPSEEK_ARK_MODEL=
TRANSIT_DEEPSEEK_MODEL=deepseek-chat
TRANSIT_QWEN_API_KEY=
TRANSIT_QWEN_MODEL=qwen3.8-flash
TRANSIT_LLM_PROVIDER=doubao
TRANSIT_LLM_FALLBACK_PROVIDER=deepseek
TRANSIT_TTS_API_KEY=
TRANSIT_TTS_APP_ID=
TRANSIT_TTS_ACCESS_TOKEN=
TRANSIT_TTS_VOICE_TYPE=
TRANSIT_TTS_CLUSTER=
TRANSIT_TTS_RESOURCE_ID=
