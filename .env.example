# ─────────────────────────────────────────
# Robot Live System — Configuration
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────

# Knowledge base backend: "flatfile" or "sqlite"
KB_PROVIDER=flatfile

# If using flatfile: path to the folder containing point JSON files
KB_FLATFILE_DIR=./data/flatfiles

# If using sqlite: path to the database file
KB_SQLITE_PATH=./data/knowledge.db

# LLM provider: "doubao" | "deepseek" | "qwen"
LLM_PROVIDER=doubao
LLM_FALLBACK_PROVIDER=deepseek

# Doubao (volcengine) — fill in when you have API access
DOUBAO_API_KEY=
DOUBAO_MODEL=ep-xxxxxxxx   # your endpoint ID on volcengine

# DeepSeek fallback
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Qwen fallback (optional second fallback)
QWEN_API_KEY=
QWEN_MODEL=qwen-turbo

# TTS — 火山引擎
TTS_APP_ID=
TTS_ACCESS_TOKEN=
TTS_VOICE_TYPE=        # built-in voice (e.g. BV001_streaming) OR cloned voice ID (e.g. S_1imisvHX1)
TTS_CLUSTER=           # volcano_tts (built-in) | volcano_icl (cloned voice)

# Banned words list (one word/phrase per line)
BANNED_WORDS_FILE=./config/banned-words.txt

# Audio ducking
DUCK_VOLUME=0.2         # robot volume when co-host is speaking (0.0 - 1.0)
DUCK_FADE_MS=500        # fade duration in milliseconds
