# ─────────────────────────────────────────
# Robot Live System — Configuration
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────

# Knowledge base backend: "flatfile" or "sqlite"
KB_PROVIDER=flatfile

# If using flatfile: path to the folder containing point JSON files
KB_FLATFILE_DIR=./data/flatfiles

# If using sqlite: path to the database file
KB_SQLITE_PATH=./data/knowledge.db

# LLM provider: "doubao" | "deepseek" | "qwen"
LLM_PROVIDER=doubao
# Optional fallback: "none" | "doubao" | "deepseek" | "qwen"
LLM_FALLBACK_PROVIDER=deepseek

# Doubao (volcengine) — fill in when you have API access
DOUBAO_API_KEY=
DOUBAO_MODEL=ep-xxxxxxxx   # your endpoint ID on volcengine

# DeepSeek (select as primary or fallback)
DEEPSEEK_API_KEY=
DEEPSEEK_PLATFORM=official
DEEPSEEK_ARK_API_KEY=
DEEPSEEK_ARK_MODEL=
DEEPSEEK_MODEL=deepseek-chat

# Qwen (select as primary or fallback; full API Key, not account ID/masked text)
QWEN_API_KEY=
QWEN_MODEL=qwen3.8-flash

# TTS — 火山引擎 V3 WebSocket 单向流式
# 新版控制台填写 TTS_API_KEY；旧版控制台填写 APP_ID + ACCESS_TOKEN。
TTS_API_KEY=
TTS_APP_ID=
TTS_ACCESS_TOKEN=
TTS_VOICE_TYPE=        # V3-compatible built-in voice ID OR cloned voice ID (e.g. S_1imisvHX1)
TTS_CLUSTER=           # volcano_tts (built-in) | volcano_icl (cloned voice)
TTS_RESOURCE_ID=       # seed-tts-1.0 (built-in) | seed-icl-1.0 (cloned); empty = inferred from cluster
TTS_AUTH_MODE=api-key  # api-key: send API_KEY/ACCESS_TOKEN as X-Api-Key; legacy: App ID + Access Key headers
TTS_TIMEOUT_MS=30000   # base timeout; long text receives a larger calculated allowance

# LLM output ceiling (tokens). The previous code hard-coded this to 500.
LLM_MAX_TOKENS=4096

# Banned words list (one word/phrase per line)
BANNED_WORDS_FILE=./config/banned-words.txt

# Audio ducking
DUCK_VOLUME=0.2         # robot volume when co-host is speaking (0.0 - 1.0)
DUCK_FADE_MS=500        # fade duration in milliseconds

# Independent barrage configuration (blank values do not inherit cruise credentials)
BARRAGE_DOUBAO_API_KEY=
BARRAGE_DOUBAO_MODEL=
BARRAGE_DEEPSEEK_API_KEY=
BARRAGE_DEEPSEEK_PLATFORM=official
BARRAGE_DEEPSEEK_ARK_API_KEY=
BARRAGE_DEEPSEEK_ARK_MODEL=
BARRAGE_DEEPSEEK_MODEL=deepseek-chat
BARRAGE_QWEN_API_KEY=
BARRAGE_QWEN_MODEL=qwen3.8-flash
BARRAGE_LLM_PROVIDER=doubao
BARRAGE_LLM_FALLBACK_PROVIDER=deepseek
BARRAGE_TTS_API_KEY=
BARRAGE_TTS_APP_ID=
BARRAGE_TTS_ACCESS_TOKEN=
BARRAGE_TTS_VOICE_TYPE=
BARRAGE_TTS_CLUSTER=
BARRAGE_TTS_RESOURCE_ID=
BARRAGE_TTS_AUTH_MODE=
BARRAGE_TTS_TIMEOUT_MS=30000
BARRAGE_LLM_MAX_TOKENS=500

# Each profile is independent; blanks never inherit another profile.
SPEECH_PROFILES_VERSION=1
# Independent credentials for transition audio and manual speech.
TRANSIT_DOUBAO_API_KEY=
TRANSIT_DOUBAO_MODEL=
TRANSIT_DEEPSEEK_API_KEY=
TRANSIT_DEEPSEEK_PLATFORM=official
TRANSIT_DEEPSEEK_ARK_API_KEY=
TRANSIT_DEEPSEEK_ARK_MODEL=
TRANSIT_DEEPSEEK_MODEL=deepseek-chat
TRANSIT_QWEN_API_KEY=
TRANSIT_QWEN_MODEL=qwen3.8-flash
TRANSIT_LLM_PROVIDER=doubao
TRANSIT_LLM_FALLBACK_PROVIDER=deepseek
TRANSIT_TTS_API_KEY=
TRANSIT_TTS_APP_ID=
TRANSIT_TTS_ACCESS_TOKEN=
TRANSIT_TTS_VOICE_TYPE=
TRANSIT_TTS_CLUSTER=
TRANSIT_TTS_RESOURCE_ID=
TRANSIT_TTS_AUTH_MODE=api-key
TRANSIT_TTS_TIMEOUT_MS=30000
TRANSIT_LLM_TIMEOUT_MS=8000
TRANSIT_LLM_MAX_TOKENS=4096
